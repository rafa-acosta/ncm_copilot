# Environment variables
.env

# Python virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated compliance reports
reports/

# Generated golden configs
output/

# Generated remediation briefings
briefing.md
briefing.json

# Generated compliance reports (compliance_report_main.py default output)
/report.md
/report.pdf

# Local LLM binaries and model weights (multi-GB, fetched by
# local-llm/install_llama_server.sh and local-llm/download_models.sh)
local-llm/bin/
local-llm/models/

# Docker deployment: GGUF models downloaded into here for the llm-engine
# container's volume mount (see documentation/DOCKER_DEPLOYMENT.md), and the
# real per-deployment .env (docker/.env.example is the tracked template).
docker/models/*
!docker/models/.gitkeep
docker/.env

# OS
.DS_Store

# Web frontend's isolated data workspace (uploads, golden config profiles,
# analysis run output) - keep the directory structure, ignore its contents.
webapp/data/*
!webapp/data/.gitkeep
!webapp/data/device_configs
webapp/data/device_configs/*
!webapp/data/golden_profiles
webapp/data/golden_profiles/*
!webapp/data/runs
webapp/data/runs/*
